# =============================================================================
# Application Settings
# =============================================================================
APP_NAME="Recruit-Rag"
APP_VERSION="0.9"

# =============================================================================
# File Upload Settings
# =============================================================================
FILE_MAX_SIZE_MB=10
FILE_ALLOWED_TYPES=["application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/plain","application/pdf"]
UPLOAD_DIRECTORY="assets/files"
FILE_CHUNK_SIZE=512000        # 0.5 MB
FILE_DEFAULT_CHUNK_SIZE=1048576  # 1 MB
FILE_BYTES_TO_MB=1048576      # 1024 * 1024

# =============================================================================
# Database Settings (MongoDB Atlas)
# =============================================================================
MONGO_DB="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>"
DB_NAME="recruit-rag-auth"

# --- Collection Names ---
PROJECTS_COLLECTION="PROJECTS_COLLECTION"
CHUNKS_COLLECTION="CHUNKS_COLLECTION"
ASSETS_COLLECTION="ASSETS_COLLECTION"
RESUMES_COLLECTION="RESUMES_COLLECTION"
JOB_DESCRIPTIONS_COLLECTION="JOB_DESCRIPTIONS_COLLECTION"

# =============================================================================
# LLM Configuration
# =============================================================================
GENERATION_BACKEND="gemini"
EMBEDDING_BACKEND="gemini"

GENERATION_MODEL_ID="gemini-3.1-flash-preview"
CV_EXTRACTION_MODEL_ID="gemini-3.1-flash-preview"
SCREENING_MODEL_ID="gemini-3.1-pro-preview"
EMBEDDING_MODEL_ID="gemini-embedding-001"
EMBEDDING_MODEL_SIZE=768

# Max parallel LLM API calls. Use 25 for paid Gemini, 15 for free tier.
LLM_CONCURRENCY_LIMIT=25

# =============================================================================
# API Keys
# =============================================================================
GROQ_API_KEY=""
GEMINI_API_KEY=""
JWT_SECRET_KEY="your_secure_jwt_secret_key_change_me_in_production"

# =============================================================================
# Vector DB Configuration (Qdrant Cloud)
# =============================================================================
VECTOR_DB_TYPE="QDRANT"
DB_DIRECTORY="assets/database"
VECTOR_DB_NAME="vector_db"
VECTOR_DB_DISTANCE="cosine"
VECTOR_DB_COLLECTION_NAME="recruit_rag_vectors"
QDRANT_URL="https://your-cluster.cloud.qdrant.io"
QDRANT_API_KEY=""

# =============================================================================
# S3 / Cloud Storage (Backblaze B2 or similar)
# =============================================================================
S3_ENDPOINT_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""

# =============================================================================
# Production Safety Settings
# =============================================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_TOKENS_PER_PROJECT_PER_MONTH=1000000
LLM_TIMEOUT_SECONDS=60

# =============================================================================
# CORS Settings
# =============================================================================
CORS_ORIGINS=["*"]

# =============================================================================
# LangSmith Tracing (set these to enable LLM call tracking)
# =============================================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="vexlo"

# =============================================================================
# HuggingFace / FastEmbed Settings
# =============================================================================
HF_HUB_DISABLE_SYMLINKS=1
